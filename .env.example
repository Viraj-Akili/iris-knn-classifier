# =============================================================================
# Environment Configuration Template for Iris ML Production System
# Copy this file to .env and adjust variables as needed: cp .env.example .env
# =============================================================================

# Frontend Configuration
IRIS_API_URL=http://backend:8000

# Backend Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# Security & CORS Whitelist (comma-separated origins)
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:3000,http://127.0.0.1:3000

# Artifact Paths
MODEL_ARTIFACT_PATH=artifacts/models/champion_pipeline.joblib
METADATA_ARTIFACT_PATH=artifacts/models/champion_metadata.json
PREDICTION_LOG_PATH=artifacts/logs/predictions.jsonl

# Observability & Confidence Thresholds
HIGH_CONFIDENCE_THRESHOLD=0.90
LOW_CONFIDENCE_THRESHOLD=0.70
ENABLE_PREDICTION_LOGGING=true

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
